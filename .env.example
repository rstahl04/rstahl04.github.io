OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep this false until paid signups are ready.
PAYMENTS_ENABLED=false

# Stripe subscription checkout. Checkout uses $4.99/month with a 7-day trial.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Email verification. Use Resend for real email delivery.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Prompter.com <verify@yourdomain.com>

# Required for login sessions. Use a long random value in production.
AUTH_SECRET=change-this-to-a-long-random-secret

# Easiest MVP access setup:
# - access "free" lets you and employees use the app without paying.
# - access "active" is the future subscription/pass state.
# - access "inactive" blocks login.
PROMPTER_USERS_JSON=[{"email":"owner@example.com","password":"change-this-password","role":"owner","access":"free"},{"email":"employee@example.com","password":"employee-password","role":"employee","access":"free"}]
